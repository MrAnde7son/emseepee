{
  "name": "hakuna",
  "version": "0.1.0",
  "description": "ESM MCP server POC for a central tools gateway with policy logging (TypeScript)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "hakuna": "./bin/cli.js"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "pnpm run build && pnpm run start",
    "dev:backend": "pnpm run build && pnpm run start",
    "dev:frontend": "cd dashboard && pnpm dev",
    "dev:all": "concurrently \"pnpm run dev:backend\" \"pnpm run dev:frontend\" --names \"backend,frontend\" --prefix-colors \"blue,green\"",
    "migrate": "node dist/db/migrate.js",
    "migrate:force": "node dist/db/migrate.js --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.2.0",
    "better-sqlite3": "11.10.0",
    "dotenv": "^17.2.3",
    "pg": "^8.13.1",
    "posthog-node": "^5.11.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^2.1.8",
    "concurrently": "^9.1.0",
    "jsdom": "^27.2.0",
    "next-router-mock": "^1.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
