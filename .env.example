# Web Search API Keys
# Copy this file to .env and fill in your API keys
# The gateway will automatically use the first available provider based on priority:
# 1. Tavily (recommended for AI agents)
# 2. SerpAPI
# 3. Google Custom Search
# 4. Bing Search
# 5. DuckDuckGo (fallback, no API key required)

# Tavily API Key (Recommended)
# Get your key at: https://tavily.com
TAVILY_API_KEY=

# SerpAPI Key
# Get your key at: https://serpapi.com
SERPAPI_KEY=

# Google Custom Search API
# Requires both API key and Custom Search Engine ID
# Get your key at: https://developers.google.com/custom-search/v1/overview
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Bing Search API Key
# Get your key at: https://www.microsoft.com/en-us/bing/apis/bing-web-search-api
BING_SEARCH_API_KEY=

# Other Gateway Configuration
AGENT_ENV=dev
ENABLED_TOOL_CATEGORIES=

# GitHub Token (for GitHub MCP server proxy)
GITHUB_TOKEN=
