# =============================================================================
# Agent Tools Gateway - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your API keys
# cp .env.example .env

# =============================================================================
# Gateway Configuration
# =============================================================================

# Environment for the agent (dev, staging, prod)
# Used for policy evaluation
AGENT_ENV=dev

# Secret used to sign dashboard/session tokens
JWT_SECRET=change-me

# Comma-separated list of tool categories to enable
# Options: file, web, third_party
# Leave empty to enable all categories with tools
# ENABLED_TOOL_CATEGORIES=file,web

# Path to config.json file (optional, defaults to config.json in project root)
# CONFIG_PATH=./config.json

# =============================================================================
# LLM Provider Configuration (for Intent Classification)
# =============================================================================

# Choose your LLM provider: openai, groq, gemini, or bedrock
LLM_PROVIDER=openai

# Optional: Override default model for your provider
# LLM_MODEL=gpt-4o-mini

# Optional: Generation parameters
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=1000
# LLM_TIMEOUT=30000

# --- OpenAI Configuration ---
# Required if LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key-here
# Optional: Custom base URL (defaults to https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Groq Configuration ---
# Required if LLM_PROVIDER=groq
# GROQ_API_KEY=gsk-your-groq-api-key-here
# Optional: Custom base URL (defaults to https://api.groq.com/openai/v1)
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Gemini Configuration ---
# Required if LLM_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key-here
# Alternative: Use GOOGLE_API_KEY instead
# GOOGLE_API_KEY=your-google-api-key-here
# Optional: Custom base URL
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1

# --- AWS Bedrock Configuration ---
# Required if LLM_PROVIDER=bedrock
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_REGION=us-east-1
# Optional: For temporary credentials
# AWS_SESSION_TOKEN=your-session-token

# =============================================================================
# Web Search API Keys (for web_search_gateway tool)
# =============================================================================
# The gateway will automatically select the first available provider in this order:
# 1. Tavily (recommended for AI-optimized search)
# 2. SerpAPI (Google results)
# 3. Google Custom Search
# 4. Bing
# 5. DuckDuckGo (fallback, no API key required)

# --- Tavily (Recommended) ---
# Get your API key from https://tavily.com
TAVILY_API_KEY=your-tavily-api-key-here

# --- SerpAPI ---
# Get your API key from https://serpapi.com
# SERPAPI_KEY=your-serpapi-key-here

# --- Google Custom Search ---
# Requires both API key and Search Engine ID
# Get API key from https://console.cloud.google.com/apis/credentials
# Create a Custom Search Engine at https://programmablesearchengine.google.com
# GOOGLE_SEARCH_API_KEY=your-google-search-api-key
# GOOGLE_SEARCH_ENGINE_ID=your-search-engine-id

# --- Bing Search ---
# Get your API key from https://www.microsoft.com/en-us/bing/apis/bing-web-search-api
# BING_SEARCH_API_KEY=your-bing-api-key-here

# =============================================================================
# Third-Party Tool API Keys
# =============================================================================
# Add API keys for any third-party tools configured in config.json
# These are referenced in your tool configurations using ${VAR_NAME} syntax

# Example: GitHub token (if using GitHub MCP server proxy)
# GITHUB_TOKEN=ghp-your-github-token-here

# Example: Slack token (if using Slack integration)
# SLACK_TOKEN=xoxb-your-slack-token-here

# Example: Policy webhook URL (if using webhook policy rules)
# POLICY_WEBHOOK_URL=https://your-webhook-endpoint.com/policy

# =============================================================================
# Notes
# =============================================================================
# - All variables are optional unless specified as "Required"
# - The gateway will work without LLM provider configuration (uses rule-based classification)
# - Web search will fall back to DuckDuckGo if no API keys are provided
# - Use environment variable substitution in config.json: ${VAR_NAME}


# JWT_SECRET=my_super_secret_jwt_token

# TLS conf
# OAUTH_ALLOW_INSECURE_TLS=true
# MCP_ALLOW_INSECURE=true
# NODE_TLS_REJECT_UNAUTHORIZED=0

# Social Login
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GITHUB_CLIENT_ID=your-github-client-id-here
GITHUB_CLIENT_SECRET=your-github-client-secret-here

GATEWAY_API_HOST=localhost
GATEWAY_API_PORT=8000
GATEWAY_API_PROTOCOL=http