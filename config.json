      "description": "Write files through the central gateway with policy enforcement.",
      "allowedRoles": [
        "coder_bot",
        "admin"
      ],
      "sensitivity": "high",
      "category": "file",
      "enabled": false
    },
    "web_search_gateway": {
      "name": "web_search_gateway",
      "description": "Perform web search through the central gateway with policy enforcement.",
      "allowedRoles": [
        "coder_bot",
        "research_bot",
        "admin"
      ],
      "sensitivity": "medium",
      "category": "web",
      "enabled": false
    },
    "terminal_command": {
      "name": "terminal_command",
      "description": "Execute terminal commands through the central gateway with policy enforcement.",
      "allowedRoles": [
        "coder_bot",
        "admin"
      ],
      "sensitivity": "high",
      "category": "terminal",
      "enabled": false
    }
  },
  "policyRules": [
    {
      "name": "block_coder_bot_secrets",
      "description": "Block coder_bot from reading files with secret in their path",
      "priority": 1,
      "condition": {
        "agentRole": "coder_bot",
        "toolName": "file_read_gateway",
        "args": {
          "path": "secret"
        }
      },
      "action": {
        "operation": "block",
        "message": "coder_bot is not allowed to read files with 'secret' in the path"
      },
      "stopOnMatch": true,
      "archived": false
    },
    {
      "name": "log_all_file_writes",
      "description": "Log all file write operations for audit",
      "priority": 5,
      "condition": {
        "category": "file",
        "toolName": "file_write_gateway"
      },
      "action": {
        "operation": "log",
        "message": "File write operation detected"
      },
      "stopOnMatch": false
    },
    {
      "name": "block_high_sensitivity_in_prod",
      "description": "Block high-sensitivity tools in production unless admin",
      "priority": 10,
      "condition": {
        "env": "prod",
        "sensitivity": "high",
        "providerId": "cursor"
      },
      "action": {
        "operation": "block",
        "message": "High-sensitivity operations require admin role in production"
      },
      "stopOnMatch": true,
      "archived": false
    },
    {
      "name": "webhook_on_sensitive_operations",
      "description": "Send webhook for sensitive operations",
      "priority": 15,
      "condition": {
        "sensitivity": "high"
      },
      "action": {
        "operation": "webhook",
        "webhookUrl": "",
        "webhookMethod": "POST"
      },
      "stopOnMatch": false
    }
  ]
}
