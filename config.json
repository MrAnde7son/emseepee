{
  "mcpServerProxies": {
    "github": {
      "name": "github",
      "description": "GitHub MCP server proxied through gateway",
      "icon": "https://github.githubassets.com/images/modules/logos_page/GitHub-Mark.png",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "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"
      },
      "enabled": true,
      "defaultPolicy": {
        "allowedRoles": [
          "coder_bot",
          "admin"
        ],
        "sensitivity": "medium"
      },
      "toolPolicyOverrides": {
        "github_create_issue": {
          "sensitivity": "high",
          "allowedRoles": [
            "admin"
          ]
        }
      }
    }
  },
  "toolsProxies": {
    "file_read_gateway": {
      "name": "file_read_gateway",
      "description": "Read files through the central gateway with policy enforcement.",
      "allowedRoles": [
        "coder_bot",
        "admin"
      ],
      "sensitivity": "medium",
      "category": "file",
      "enabled": true
    },
    "file_search_gateway": {
      "name": "file_search_gateway",
      "description": "Search for files through the central gateway with policy enforcement.",
      "allowedRoles": [
        "coder_bot",
        "admin"
      ],
      "sensitivity": "medium",
      "category": "file",
      "enabled": true
    },
    "file_write_gateway": {
      "name": "file_write_gateway",
      "description": "Write files through the central gateway with policy enforcement.",
      "allowedRoles": [
        "coder_bot",
        "admin"
      ],
      "sensitivity": "high",
      "category": "file",
      "enabled": true
    },
    "web_search_gateway": {
      "name": "web_search_gateway",
      "description": "Perform web search through the central gateway with policy enforcement.",
      "allowedRoles": [
        "coder_bot",
        "research_bot",
        "admin"
      ],
      "sensitivity": "medium",
      "category": "browser",
      "enabled": true
    },
    "terminal_command": {
      "name": "terminal_command",
      "description": "Execute terminal commands through the central gateway with policy enforcement.",
      "allowedRoles": [
        "coder_bot",
        "admin"
      ],
      "sensitivity": "high",
      "category": "terminal",
      "enabled": true
    },
    "slack_send_message": {
      "name": "slack_send_message",
      "description": "Send a message to a Slack channel through the gateway.",
      "allowedRoles": [
        "coder_bot",
        "admin"
      ],
      "sensitivity": "medium",
      "category": "third_party",
      "enabled": true,
      "execution": {
        "type": "http",
        "method": "POST",
        "url": "https://slack.com/api/chat.postMessage",
        "headers": {
          "Authorization": "Bearer ",
          "Content-Type": "application/json"
        },
        "bodyTemplate": "{\"channel\": \"{channel}\", \"text\": \"{message}\"}",
        "responsePath": "ok"
      },
      "inputSchema": {
        "channel": {
          "type": "string",
          "description": "Slack channel ID or name",
          "required": true
        },
        "message": {
          "type": "string",
          "description": "Message to send",
          "required": true
        }
      }
    }
  },
  "policyRules": [
    {
      "name": "block_coder_bot_secrets",
      "description": "Block coder_bot from reading files with secret in their path",
      "priority": 1,
      "condition": {
        "agentRole": "coder_bot",
        "toolName": "file_read_gateway",
        "args": {
          "path": "secret"
        }
      },
      "action": {
        "operation": "block",
        "message": "coder_bot is not allowed to read files with 'secret' in the path"
      },
      "stopOnMatch": true,
      "archived": false
    },
    {
      "name": "log_all_file_writes",
      "description": "Log all file write operations for audit",
      "priority": 5,
      "condition": {
        "category": "file",
        "toolName": "file_write_gateway"
      },
      "action": {
        "operation": "log",
        "message": "File write operation detected"
      },
      "stopOnMatch": false
    },
    {
      "name": "block_high_sensitivity_in_prod",
      "description": "Block high-sensitivity tools in production unless admin",
      "priority": 10,
      "condition": {
        "env": "prod",
        "sensitivity": "high",
        "agentRole": [
          "coder_bot",
          "research_bot"
        ]
      },
      "action": {
        "operation": "block",
        "message": "High-sensitivity operations require admin role in production"
      },
      "stopOnMatch": true
    },
    {
      "name": "webhook_on_sensitive_operations",
      "description": "Send webhook for sensitive operations",
      "priority": 15,
      "condition": {
        "sensitivity": "high"
      },
      "action": {
        "operation": "webhook",
        "webhookUrl": "",
        "webhookMethod": "POST"
      },
      "stopOnMatch": false
    }
  ]
}
